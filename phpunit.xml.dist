<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/tollwerk/guidelines/config/typo3-bootstrap.php"
         cacheDirectory=".phpunit.cache"
         executionOrder="random"
         beStrictAboutOutputDuringTests="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnSkipped="true"
         failOnIncomplete="true"
         failOnEmptyTestSuite="true">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="functional">
            <directory>tests/Functional</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>Classes</directory>
        </include>
    </source>
    <php>
        <!-- The tests never depend on the context of the shell or the container they run in -->
        <env name="TYPO3_CONTEXT" value="Testing" force="true"/>
        <!-- Functional tests build their instance of TYPO3 on SQLite. A project whose tests need the database of
             production sets the variables typo3Database* for MariaDB in its pipeline -->
        <env name="typo3DatabaseDriver" value="pdo_sqlite"/>
    </php>
</phpunit>
