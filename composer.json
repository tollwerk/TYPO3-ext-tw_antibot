{
  "name": "tollwerk/tw-antibot",
  "type": "typo3-cms-extension",
  "description": "Death to Spambots! — CAPTCHA-less spam security for TYPO3 forms",
  "homepage": "https://github.com/tollwerk/TYPO3-ext-tw_antibot",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Joschi Kuphal",
      "email": "joschi@tollwerk.de"
    }
  ],
  "require": {
    "php": "^7.4",
    "typo3/cms-core": "^10.4",
    "typo3/cms-form": "^10.4",
    "jkphl/antibot": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Tollwerk\\TwAntibot\\": "Classes"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tollwerk\\TwAntibot\\Tests\\": "Tests"
    }
  },
  "replace": {
    "typo3-ter/tw_antibot": "self.version"
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "tw_antibot"
    }
  }
}
